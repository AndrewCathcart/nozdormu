{
  "name": "@nozdormu/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "smoke": "node --env-file-if-exists=../../.env scripts/smoke.ts",
    "migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "job": "node --env-file-if-exists=../../.env scripts/run-job.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@nozdormu/blueposts": "workspace:*",
    "@nozdormu/core": "workspace:*",
    "@nozdormu/db": "workspace:*",
    "@nozdormu/digest": "workspace:*",
    "@nozdormu/dungeons": "workspace:*",
    "@nozdormu/gamedata": "workspace:*",
    "@nozdormu/ping": "workspace:*",
    "@nozdormu/youtube": "workspace:*",
    "discord.js": "catalog:",
    "zod": "catalog:"
  }
}
