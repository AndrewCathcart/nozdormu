# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DATABASE_URL=
YOUTUBE_ALERT_CHANNEL_ID=
# From the Claude Console workspace for the bot, which has a monthly spend limit.
ANTHROPIC_API_KEY=
# From the OpenAI project for the bot, which has a monthly spend limit. Paints the digest's picture.
OPENAI_API_KEY=
# The channels the weekly digest reads, as Discord IDs separated by commas. The bot needs View
# Channel and Read Message History in each.
DIGEST_CHANNEL_IDS=
# The channel the digest is posted in. The bot needs Send Messages and Attach Files there.
DIGEST_POST_CHANNEL_ID=
# Where Forever news is posted, such as Blizzard staff forum posts. The bot needs View Channel, Send
# Messages, Embed Links and Read Message History there.
FOREVER_NEWS_CHANNEL_ID=
