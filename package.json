{
  "name": "nozdormu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nozdormu/bot dev",
    "start": "pnpm --filter @nozdormu/bot start",
    "smoke": "pnpm --filter @nozdormu/bot smoke",
    "job": "pnpm --filter @nozdormu/bot job",
    "db:generate": "pnpm --filter @nozdormu/db generate",
    "db:migrate": "pnpm --filter @nozdormu/bot migrate",
    "prepare": "lefthook install",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.10.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
